# Optional development override. The pnpm start/android/ios/web commands detect the LAN address.
# Use this only when automatic detection selects the wrong network interface.
# EXPO_PUBLIC_API_URL=http://192.168.x.x:8080

# Optional backend override when running Yze.Api outside Compose. The default is Data Source=yze.db.
# ConnectionStrings__Yze=Data Source=/absolute/path/to/yze.db
